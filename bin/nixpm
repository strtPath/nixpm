#!/usr/bin/env bash
# shellcheck disable=SC1090,SC2034,SC2021
#   SC1090: config path is dynamic (~/.config/nixpm/config), can't be followed.
#   SC2034: C_CYN is set for API symmetry with the other color vars.
#   SC2021: tr `[...]` here intentionally includes literal chars in the set.
#
# nixpm — Tiny Nix package manager wrapper with optional desktop integration
#
# A friendly frontend to nix-env inspired by pacman / brew.
# Works on any Linux/macOS system with Nix installed.
# Optionally reloads desktop launchers after install/remove so new apps
# appear right away (Omarchy, Hyprland, etc.).
#
# Install:      cp bin/nixpm ~/.local/bin/
#               chmod +x ~/.local/bin/nixpm
#
# Config:       ~/.config/nixpm/config  (sourced, optional)
#
# Project:      https://github.com/strtPath/nixpm
# License:      MIT

set -euo pipefail

# bash >= 4 required (mapfile in cmd_prune). macOS ships bash 3.2 — say so up
# front instead of dying mid-command with 'mapfile: command not found'.
if [[ -z "${BASH_VERSINFO:-}" || ${BASH_VERSINFO[0]} -lt 4 ]]; then
  printf '==> nixpm requires bash >= 4 (found %s). On macOS: brew install bash.\n' \
    "${BASH_VERSION:-unknown}" >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# Hardcoded globals (override via config or env)
# ---------------------------------------------------------------------------
readonly NIXPM_VERSION="0.3.1"

# ---------------------------------------------------------------------------
# Configuration (sourced from file, optional)
# ---------------------------------------------------------------------------
: "${XDG_CONFIG_HOME:=${HOME}/.config}"
NIXPM_CONFIG="${XDG_CONFIG_HOME}/nixpm/config"
[[ -f "$NIXPM_CONFIG" ]] && source "$NIXPM_CONFIG"

NIXPM_NIXPKGS="${NIXPM_NIXPKGS:-nixpkgs}"
# true|false|auto  (auto=restart only if a supported DE/WM is detected)
NIXPM_RESTART_MENU="${NIXPM_RESTART_MENU:-auto}"
: "${NIXPM_SEARCH_CACHE_DIR:="${XDG_CACHE_HOME:-$HOME/.cache}/nixpm"}"
: "${NIXPM_SEARCH_TTL:=86400}"   # seconds an index may be reused before rebuild
: "${NIXPM_SEARCH_WORKERS:=4}"   # eval workers (no-op on upstream nix, honoured by Determinate Nix)
: "${NIXPM_MIN_INDEX_MEM_MB:=6144}" # min RAM for full-package-set evals; 0 disables the gate
# Test hooks for the RAM gate (normally /proc + /sys paths):
: "${NIXPM_MEMINFO_FILE:=/proc/meminfo}"
: "${NIXPM_CGROUP_FILE:=}"   # empty = auto-detect cgroup v2 then v1 limit

# ---------------------------------------------------------------------------
# Terminal colors
# ---------------------------------------------------------------------------
if [[ -t 1 ]]; then
  C_B=$'\033[1m'; C_GRN=$'\033[32m'; C_RED=$'\033[31m'; C_YEL=$'\033[33m'
  C_BLU=$'\033[34m'; C_CYN=$'\033[36m'; C_RST=$'\033[0m'
else
  C_B=""; C_GRN=""; C_RED=""; C_YEL=""; C_BLU=""; C_CYN=""; C_RST=""
fi

# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------
out()    { printf "${C_BLU}%s${C_RST} %s\n" "==>" "$*"; }
ok()     { printf "${C_GRN}%s${C_RST} %s\n" "==>" "$*"; }
warn()   { printf "${C_YEL}%s${C_RST} %s\n" "=>" "$*" >&2; }
err()    { printf "${C_RED}%s${C_RST} %s\n" "==>" "$*" >&2; }
info()   { printf "  %s\n" "$*"; }
die()    { err "$*"; exit 1; }

# ---------------------------------------------------------------------------
# Primitives
# ---------------------------------------------------------------------------
has_cmd()       { command -v "$1" >/dev/null 2>&1; }
is_running()    { pgrep -x "$1" >/dev/null 2>&1; }
xdg_conf_dir()  { printf '%s' "${XDG_CONFIG_HOME:-$HOME/.config}"; }

# ---------------------------------------------------------------------------
# Desktop-session detection & reload helpers
# ---------------------------------------------------------------------------

# Print a one-liner telling the user how to make .desktop files visible.
_reload_hint_text() {
  cat <<'EOF'
Some Nix packages ship .desktop files. Desktop launchers need one of:
  1) Log out and back in, or
  2) Restart your desktop shell / panel / launcher (see README).
EOF
}

# Attempt to reload the active session so new .desktop files are picked up.
# Returns 0 if any action was taken, 1 otherwise.
_reload_session() {
  if [[ "$NIXPM_RESTART_MENU" == "false" ]]; then
    return 1
  fi

  local auto=false
  [[ "$NIXPM_RESTART_MENU" == "auto" ]] && auto=true

  # 1) Omarchy (Hyprland + Quickshell)
  if has_cmd omarchy && is_running Hyprland; then
    if $auto || [[ "$NIXPM_RESTART_MENU" == "true" ]]; then
      out "Restarting Omarchy shell to refresh the app menu..."
      if omarchy restart shell 2>/dev/null; then
        ok "Omarchy shell restarted."
        return 0
      else
        warn "Shell restart failed (maybe busy/locked)."
      fi
    fi
    return 1
  fi

  # 2) Plain Hyprland (no Omarchy)
  if is_running Hyprland && has_cmd hyprctl; then
    if $auto || [[ "$NIXPM_RESTART_MENU" == "true" ]]; then
      out "Reloading Hyprland to pick up new environment..."
      if hyprctl reload 2>/dev/null; then
        ok "Hyprland reloaded."
        info "You may still need to restart your launcher (waybar, rofi, wofi, etc.)."
        return 0
      fi
    fi
    return 1
  fi

  # 3) GNOME / Mutter
  if is_running gnome-shell && has_cmd gsettings; then
    # There's no reliable GNOME "reload" — logging out is the only way
    return 1
  fi

  # 4) KDE Plasma
  if is_running plasmashell && has_cmd kbuildsycoca6; then
    if $auto || [[ "$NIXPM_RESTART_MENU" == "true" ]]; then
      out "Rebuilding Plasma application database..."
      kbuildsycoca6 2>/dev/null && ok "Done." && return 0
    fi
    return 1
  fi

  # 5) Sway
  if is_running sway && has_cmd swaymsg; then
    if $auto || [[ "$NIXPM_RESTART_MENU" == "true" ]]; then
      out "Reloading Sway..."
      swaymsg reload 2>/dev/null && return 0
    fi
    return 1
  fi

  # If auto mode and nothing matched, stay silent and return 1.
  # If true mode and nothing matched, warn.
  if [[ "$NIXPM_RESTART_MENU" == "true" ]]; then
    warn "Could not detect a supported desktop session to reload."
  fi
  return 1
}

# Wrapper used after install / remove. Always shows a hint if reload was skipped.
_post_install_reload() {
  if ! _reload_session; then
    _reload_hint_text
  fi
}

# ---------------------------------------------------------------------------
# Nix helpers
# ---------------------------------------------------------------------------

# Run a nix subcommand with the common experimental features enabled.
_nix_x() {
  nix --extra-experimental-features nix-command \
      --extra-experimental-features flakes "$@"
}

# ---------------------------------------------------------------------------
# Full-evaluation RAM gate (R3)
#
# Two nixpm operations evaluate the ENTIRE nixpkgs package set: the cold
# search index build, and the full `nix-env -u` upgrade scan. On machines
# below roughly 6GB that is not slow — it is fatal (observed on a clean 4GB
# container: load 21, ssh dead, hypervisor reset needed). These commands
# refuse below NIXPM_MIN_INDEX_MEM_MB; everything else (install/remove/list
# of single packages) never full-evals and stays ungated.
# ---------------------------------------------------------------------------

# Effective memory in MB: MemTotal, capped by any cgroup limit that applies
# (containers). Treats "max" and the cgroup-v1 unlimited sentinel as absent.
# Prints nothing when the size cannot be determined — callers treat unknown
# as "big enough" (never refuse on a read failure).
_effective_mem_mb() {
  local v best="" f
  v="$(awk '/^MemTotal:/{print $2; exit}' "${NIXPM_MEMINFO_FILE:-/proc/meminfo}" 2>/dev/null)" || true
  [[ "$v" =~ ^[0-9]+$ ]] && best=$(( v / 1024 ))
  for f in "${NIXPM_CGROUP_FILE:-}" \
           /sys/fs/cgroup/memory.max \
           /sys/fs/cgroup/memory/memory.limit_in_bytes; do
    [[ -n "$f" && -r "$f" ]] || continue
    v="$(head -n 1 "$f" 2>/dev/null)" || true
    [[ "$v" =~ ^[0-9]+$ ]] || continue              # "max" or junk = no limit
    (( v >= (1 << 60) )) && continue                # cgroup v1 unlimited sentinel
    v=$(( v / 1048576 ))
    [[ -z "$best" || $v -lt $best ]] && best=$v
  done
  [[ -n "$best" ]] && printf '%s\n' "$best"
  return 0
}

# Prints the refusal (stderr) and returns 1 when the machine is too small
# for a full evaluation; returns 0 when the operation may run. Callers exit
# 3 (= "cannot run", distinct from 1 = failure/no-match).
_full_eval_gate() {
  local what="$1" hint="$2" need="${NIXPM_MIN_INDEX_MEM_MB:-6144}" mem
  [[ "$need" =~ ^[0-9]+$ ]] || need=6144
  (( need == 0 )) && return 0
  mem="$(_effective_mem_mb)"
  [[ -n "$mem" ]] || return 0
  (( mem >= need )) && return 0
  err "Low-RAM mode: ${what} needs ~$(( (need + 1023) / 1024 ))GB of memory (found ${mem}MB) and can freeze this machine."
  info "$hint"
  info "Or set NIXPM_MIN_INDEX_MEM_MB=0 to try anyway."
  return 1
}

# ---------------------------------------------------------------------------
# Local search index
#
# `nix search` re-evaluates the *whole* nixpkgs attribute set on every call
# (the regex filter is applied after evaluation), which is why it feels slow
# next to pacman — pacman just greps a pre-built local index. We mirror that:
# build a local "all packages" index once, then grep it. The index is rebuilt
# lazily on search when it goes stale (TTL, or after a channel refresh — see
# _channel_marker_path). It is intentionally NOT rebuilt eagerly by `nixpm
# update`; that full-attribute eval is expensive and search-only.
# ---------------------------------------------------------------------------

# Cache filename for the given NIXPM_NIXPKGS value (sanitised so nixpkgs,
# nixpkgs/nixos-24.05 & friends each get their own index).
_search_index_path() {
  local base
  base="$(printf '%s' "${NIXPM_NIXPKGS}" | tr '[/.#[:space:]]' '_____')"
  printf '%s\n' "${NIXPM_SEARCH_CACHE_DIR}/${base}-search"
}

# Marker recording when the channel/flake was last refreshed. A new copy of the
# index is *not* built eagerly at update time (that's the slow full-attribute
# eval); instead this marker lets the next `search` see that the cached index
# predates the refreshed source and rebuild it lazily.
_channel_marker_path() {
  printf '%s\n' "${NIXPM_SEARCH_CACHE_DIR}/.last-update"
}

# Record that the package source changed. Called after a successful channel or
# flake refresh so a pre-existing search index is treated as stale.
_mark_channel_updated() {
  mkdir -p "$NIXPM_SEARCH_CACHE_DIR" 2>/dev/null
  touch "$(_channel_marker_path)" 2>/dev/null || true
}

# Is there a reasonably-fresh local index we can grep? 0=fresh, 1=missing/stale.
# Fresh means it exists, is within the TTL, AND is newer than the last channel
# refresh (an updated source invalidates any index built before it).
_search_index_fresh() {
  local path now marker imt mmt
  path="$(_search_index_path)"
  [[ -f "$path" ]] || return 1
  now="$(date +%s)"
  imt="$(stat -c %Y "$path" 2>/dev/null || stat -f %m "$path" 2>/dev/null || echo 0)"
  [[ $((now - imt)) -lt ${NIXPM_SEARCH_TTL:-86400} ]] || return 1
  marker="$(_channel_marker_path)"
  if [[ -f "$marker" ]]; then
    mmt="$(stat -c %Y "$marker" 2>/dev/null || stat -f %m "$marker" 2>/dev/null || echo 0)"
    # Strictly newer, not >=: index and marker mtimes carry whole-second
    # precision, so an index built in the same second the channel refreshed
    # could predate it and serve stale results.
    [[ "$imt" -gt "$mmt" ]] || return 1
  fi
  return 0
}

# Build a local "all packages" index. Returns the path on success, 1 on failure.
# Callers must pass the full-eval RAM gate first: this evaluates ALL of nixpkgs.
_build_search_index() {
  mkdir -p "$NIXPM_SEARCH_CACHE_DIR" || return 1
  local path tmp rc hb=""
  path="$(_search_index_path)"
  tmp="${path}.$$"

  # Heartbeat: a cold build runs for minutes and nix's own progress goes to
  # /dev/null (below), so print our own counter to show the wait is alive.
  # The ticker MUST die when this function ends — an orphaned ticker prints
  # "building index... 80s" over the NEXT command. Sleep in 1s increments (not
  # one long sleep): bash defers SIGTERM until the running sleep returns, so a
  # `sleep 10` loop would stall every search by up to 10s at kill time.
  _stop_hb() {
    [[ -n "${hb:-}" ]] && { kill "$hb" 2>/dev/null || true; wait "$hb" 2>/dev/null || true; hb=""; }
    return 0
  }
  trap '_stop_hb' RETURN INT TERM
  (
    n=0
    while sleep 1; do
      n=$((n + 1))
      (( n % 10 == 0 )) && printf '  building index... %ss\n' "$n" >&2
    done
  ) &
  hb=$!

  # "^" matches every package. Evaluate just once (the workers passthrough is
  # ignored by upstream nix, which warns about the unknown setting, but real
  # on Determinate Nix), then write a clean, grep-able text index atomically.
  if _nix_x search "$NIXPM_NIXPKGS" "^" \
       --option workers "${NIXPM_SEARCH_WORKERS:-4}" \
       >"$tmp" 2>/dev/null; then
    if sed -E -e 's/\x1b\[[0-9;]*m//g' \
         -e 's/^\* legacyPackages\.[a-zA-Z0-9_-]+\./\* /' "$tmp" > "${tmp}.c"; then
      rc=0
    else
      rc=1
    fi
  else
    rc=1
  fi
  _stop_hb
  if [[ $rc -eq 0 ]]; then
    mv -f "${tmp}.c" "$path"
    rm -f "$tmp"   # raw pre-sed output is no longer needed
    printf '%s\n' "$path"
  else
    rm -f "$tmp" "${tmp}.c"
    return 1
  fi
}

# Escape every ERE metacharacter so a query matches as a literal string
# (search queries are plain text, not regex). The result MUST reach awk via
# the environment (ENVIRON["RE"]) — `awk -v re=...` processes backslash
# escapes itself and silently eats ours. Total function: every '\' is itself
# escaped, so a trailing lone backslash cannot break the pattern; an empty
# result is refused by the caller (an empty RE would match every package).
_ere_escape() {
  local q="$1" out="" i c
  for ((i = 0; i < ${#q}; i++)); do
    c="${q:i:1}"
    case "$c" in
      '.'|'^'|'$'|'['|']'|'{'|'}'|'('|')'|'*'|'+'|'?'|'|'|'\') out+="\\$c" ;;
      *) out+="$c" ;;
    esac
  done
  printf '%s' "$out"
}

# Grep a built index for a query across both package names and descriptions,
# wrapping descriptions to the terminal width so narrow (tiled) terminals get
# clean, indented continuation lines instead of confusing overflow.
_search_cache_grep() {
  local query="$1" index="$2" cols re
  [[ -n "$query" ]] || return 1        # guard AGAIN: empty query = match-everything RE
  re="$(_ere_escape "$query")"
  [[ -n "$re" ]] || return 1
  cols="$(_term_cols)"
  RE="$re" awk -v cols="$cols" '
    BEGIN { IGNORECASE = 1; re = ENVIRON["RE"] }
    /^\* / {
      if (name != "" && keep) print_block()
      name = $0; sub(/^\* /, "", name)
      desc = ""; keep = (name ~ re)
      next
    }
    {
      line = $0; sub(/^  /, "", line)
      if (desc == "") desc = line; else desc = desc " " line
      if (line ~ re) keep = 1
      next
    }
    END { if (name != "" && keep) print_block() }
    function print_block(    rest, w) {
      if (length(name) > cols - 10) name = substr(name, 1, cols - 13) "..."
      if (length(desc) > (cols - 2) * 3) desc = substr(desc, 1, (cols - 2) * 3 - 3) "..."
      printf "* %s\n", name
      rest = desc
      while (length(rest) > cols - 2) {
        w = cols - 2
        while (w > 0 && substr(rest, w, 1) != " ") w--
        if (w <= 0) w = cols - 2
        printf "  %s\n", substr(rest, 1, w)
        rest = substr(rest, w + 1)
        sub(/^ +/, "", rest)
      }
      if (rest != "") printf "  %s\n", rest
    }
  ' "$index" | sed -n '1,50p'
}

# ---------------------------------------------------------------------------
# Terminal width / profile-generation helpers
# ---------------------------------------------------------------------------

# Terminal width for wrapping output (sane default when output is piped).
_term_cols() {
  local cols
  cols="$(tput cols 2>/dev/null || echo 100)"
  [[ "$cols" =~ ^[0-9]+$ && "$cols" -ge 40 ]] || cols=100
  printf '%s\n' "$cols"
}

# Nix user-profile directory (XDG state layout used by Nix 2.15+).
_profile_dir() {
  printf '%s\n' "${XDG_STATE_HOME:-$HOME/.local/state}/nix/profiles"
}

# Resolve a symlink to its absolute target. GNU readlink -f isn't available on
# macOS/BSD, so fall back to realpath / python3, then to the input path.
_realpath() {
  local p="$1" out
  out="$(readlink -f -- "$p" 2>/dev/null)" && { printf '%s\n' "$out"; return 0; }
  out="$(command -v realpath >/dev/null 2>&1 && realpath "$p" 2>/dev/null)" && { printf '%s\n' "$out"; return 0; }
  out="$(command -v python3 >/dev/null 2>&1 && python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' -- "$p" 2>/dev/null)" && { printf '%s\n' "$out"; return 0; }
  printf '%s\n' "$p"
}

# Human size of the closure a store path keeps alive ("gone" / "unknown").
_gen_closure_size() {
  local p="$1" out
  [[ -e "$p" ]] || { printf 'gone\n'; return 0; }
  out="$(_nix_x path-info --closure-size --human-readable "$p" 2>/dev/null)" || { printf 'unknown\n'; return 0; }
  printf '%s\n' "$out" | awk '{print $(NF-1) " " $NF; exit}'
}

# List one profile's generations as "N<tab>created<tab>size" (sorted by N).
_profile_generations() {
  local base="$1" dir link b n when size
  dir="$(_profile_dir)"
  [[ -d "$dir" ]] || return 0
  for link in "$dir"/"$base"-*-link; do
    [[ -L "$link" ]] || continue
    b="$(basename "$link")"
    n="${b#"$base"-}"
    n="${n%-link}"
    [[ "$n" =~ ^[0-9]+$ ]] || continue
    when="$( { stat -c %y "$link" 2>/dev/null || stat -f '%Sm' -t '%Y-%m-%d %H:%M:%S' "$link" 2>/dev/null; } | cut -d. -f1)"
    size="$(_gen_closure_size "$(_realpath "$link")")"
    printf '%s\t%s\t%s\n' "$n" "$when" "$size"
  done | sort -n -t$'\t' -k1,1
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_search() {
  local query cols
  query="${1:-}"
  [[ -z "$query" ]] && die "Usage: nixpm search <query>"
  cols="$(_term_cols)"
  out "Searching nixpkgs for '${query}'..."

  # Fast path: a reasonably-fresh local index already exists, so just grep it
  # (the same cost as pacman grepping its sync database).
  if _search_index_fresh; then
    local hits rc=0
    hits="$(_search_cache_grep "$query" "$(_search_index_path)")" || rc=$?
    if [[ $rc -ne 0 ]]; then
      warn "Local index search failed (exit $rc) — falling back to live search."
      _live_search_fallback "$query"
    fi
    if [[ -n "$hits" ]]; then
      printf '%s\n' "$hits"
      return 0
    fi
    warn "No packages in '${NIXPM_NIXPKGS}' match '${query}'."
    exit 1
  fi

  # Slow path: no fresh index yet. nix evaluates the *entire* package set for
  # any search, so run the full-eval RAM gate first (R3), then build the full
  # local index from this one evaluation and serve the query from it. That
  # turns the next `nixpm search` into an instant local grep.
  _full_eval_gate "the search index (nix evaluates the whole package set)" \
      "Install packages directly by name — 'nixpm install <name>' instantiates only that one attr." \
      || exit 3
  out "Building local search index (first search is slower; later ones are instant)..."
  local index match
  if index="$(_build_search_index)"; then
    match="$(_search_cache_grep "$query" "$index")"
    if [[ -n "$match" ]]; then
      printf '%s\n' "$match"
      return 0
    fi
    warn "No packages in '${NIXPM_NIXPKGS}' match '${query}'."
    exit 1
  fi

  # Index build failed (e.g. no network). Fall back to a plain live search with
  # the original error reporting, so the user always sees *why*.
  _live_search_fallback "$query"
}

# Last-resort live search through `nix search` with full error reporting.
# NOTE: this also evaluates the entire package set, so the RAM gate is
# re-checked here — the warm-index path can land here when the index grep
# fails unexpectedly. nix search treats its term as a regex, so the literal
# query is passed escaped.
_live_search_fallback() {
  local query="$1" cols errfile raw rc=0
  _full_eval_gate "the live nix search (nix evaluates the whole package set)" \
      "Install packages directly by name — 'nixpm install <name>' instantiates only that one attr." \
      || exit 3
  cols="$(_term_cols)"
  errfile="$(mktemp)" || die "Failed to create a temporary file."
  raw="$(_nix_x search "$NIXPM_NIXPKGS" "$(_ere_escape "$query")" 2>"$errfile")" || rc=$?

  # "No matches" on its own: nix exits 0 (or 1 on newer versions with an
  # "error: no results ..." note) and prints nothing to stdout.
  if [[ -z "$raw" ]] && { [[ $rc -eq 0 ]] || grep -q "no results for the given search term" "$errfile"; }; then
    rm -f "$errfile"
    warn "No packages in '${NIXPM_NIXPKGS}' match '${query}'."
    exit 1
  fi

  if [[ $rc -ne 0 ]]; then
    err "nix search failed (exit $rc):"
    if [[ -s "$errfile" ]]; then
      # Drop per-attribute progress noise, keep the actual diagnostics.
      grep -v "^[[:space:]]*evaluating " "$errfile" | sed 's/^/  /' | tail -20 >&2
    else
      info "(nix printed no diagnostics)"
    fi
    rm -f "$errfile"
    exit 1
  fi
  rm -f "$errfile"
  printf '%s\n' "$raw" | \
    sed -E 's/\x1b\[[0-9;]*m//g' | \
    sed -E 's/^\* legacyPackages\.[a-zA-Z0-9_-]+\./* /' | \
    awk -v cols="$cols" '
      BEGIN { pkg=""; desc=""; has_pkg=0 }
      /^\* / {
        if (has_pkg) print_entry()
        pkg = $0; sub(/^\* /, "", pkg)
        desc = ""; has_pkg = 1; next
      }
      /^  / { sub(/^  /, ""); desc = (desc=="" ? $0 : desc " " $0); next }
      { if (has_pkg) desc = desc " " $0 }
      END { if (has_pkg) print_entry() }
      function print_entry(    rest, w) {
        if (length(pkg) > cols - 10) pkg = substr(pkg, 1, cols - 13) "..."
        if (length(desc) > (cols - 2) * 3) desc = substr(desc, 1, (cols - 2) * 3 - 3) "..."
        printf "%s\n", pkg
        rest = desc
        while (length(rest) > cols - 2) {
          w = cols - 2
          while (w > 0 && substr(rest, w, 1) != " ") w--
          if (w <= 0) w = cols - 2
          printf "  %s\n", substr(rest, 1, w)
          rest = substr(rest, w + 1)
          sub(/^ +/, "", rest)
        }
        if (rest != "") printf "  %s\n", rest
      }
    ' | sed -n '1,50p'
}

cmd_install() {
  [[ $# -eq 0 ]] && die "Usage: nixpm install <pkg> [pkg...]"
  for pkg in "$@"; do
    out "Installing ${C_B}${pkg}${C_RST} from ${NIXPM_NIXPKGS}..."
    nix-env -iA "${NIXPM_NIXPKGS}.${pkg}"
    ok "Installed ${pkg}."
  done
  _post_install_reload
}

cmd_remove() {
  [[ $# -eq 0 ]] && die "Usage: nixpm remove <pkg> [pkg...]"
  for pkg in "$@"; do
    out "Removing ${C_B}${pkg}${C_RST}..."
    nix-env -e "$pkg"
    ok "Removed ${pkg}."
  done
  _post_install_reload
}

cmd_list() {
  out "Installed Nix packages:"
  nix-env -q
}

cmd_list_derivations() {
  out "Installed packages with store paths:"
  nix-env -q --out-path
}

# Refresh the package source (traditional channels first, flakes as a
# fallback). `nix-env` only ever sees the snapshot that is already fetched,
# so refresh must happen before upgrade/install can see newer versions.
_update_index() {
  out "Refreshing package index..."
  if nix-channel --update 2>/dev/null; then
    ok "Channels updated."
    _mark_channel_updated
    return 0
  fi

  warn "nix-channel --update failed (maybe using flakes?)."
  # Only touch a flake lock when we're actually inside a flake project —
  # never go wandering up parent directories and rewrite someone's
  # flake.lock just because an upgrade was run from there.
  if [[ -f flake.nix || -f flake.lock ]] && has_cmd nix && _nix_x flake update 2>/dev/null; then
    ok "Flake inputs updated."
    _mark_channel_updated
    return 0
  fi

  warn "No traditional channels or flakes registry found to update."
  return 1
}

cmd_update() {
  if _update_index; then
    _offer_update_preview
  fi
}

# After a fresh channel update, offer to preview which installed packages can be
# upgraded. The preview runs `nix-env -u --dry-run` (see _preview_updates), so it
# uses nix's own notion of "upgradeable" rather than guessing from a search index.
_offer_update_preview() {
  [[ -t 0 ]] || return 0
  local resp
  read -rp "Show which installed packages can be upgraded? [y/N] " resp || resp=""
  case "$resp" in
    y|Y|yes|Yes|YES) _preview_updates ;;
  esac
}

_preview_updates() {
  local work rc=0 decisions
  # A --dry-run scan instantiates the whole package set to compare versions —
  # the same full evaluation as a cold search. On small machines skip the
  # preview but let the (ungated) refresh itself finish.
  if ! _full_eval_gate "the upgrade preview (nix-env -u --dry-run scans the whole package set)" \
        "Skip it on small machines; 'nixpm upgrade <name>' upgrades one package without any scan."; then
    return 0
  fi
  work="$(mktemp)" || die "Failed to create a temporary file."

  out "Checking for upgradeable packages (dry run)..."
  # `nix-env -u --dry-run` reuses nix's own upgrade logic and profile wiring,
  # so there's no need to parse a separately-built search index or fork a
  # `nix eval` per candidate package. It prints an "upgrading 'A' to 'B'" line
  # (to stderr) for every move it *would* make — same format _upgrade_run sees.
  if nix-env -u --dry-run >/dev/null 2>"$work"; then
    rc=0
  else
    rc=$?
  fi

  # Keep only the upgrade/downgrade decisions; the rest of the dry-run chatter
  # (evaluation warnings, "would be built" lists) is noise for the user.
  # `|| true` guards the no-match case: grep exits 1 when nothing matches, and
  # with set -euo pipefail that would abort before we can report "up to date".
  decisions="$(grep -E "^(upgrading|downgrading) '" "$work" 2>/dev/null | \
    sed -E "s/^upgrading '//; s/^downgrading '/(downgraded) /; s/' to '/ -> /; s/'$//" || true)"
  rm -f "$work"

  if [[ $rc -ne 0 ]]; then
    warn "nix-env dry run failed (exit $rc) — could not determine upgradeable packages."
    return 1
  fi

  if [[ -z "$decisions" ]]; then
    ok "All installed packages are already up to date."
    return 0
  fi

  # Decisions can include downgrades too, so don't claim these are upgrades.
  ok "Package changes available:"
  printf '%s\n' "$decisions" | sort -u | sed 's/^/  /'
  info "Install them with: nixpm upgrade"
}

# Run one `nix-env -u` invocation, streaming output straight to the terminal, and
# write the "upgrading 'A' to 'B'" lines to $1 so the caller can print a summary at
# the end — no one should have to scroll up past the fetched-paths noise.
_upgrade_run() {
  local sumfile="$1" tmp rc=0 out; shift
  tmp="$(mktemp)" || die "Failed to create a temporary file."
  if "$@" 2>&1 | tee "$tmp"; then
    rc=0
  else
    rc=$?
  fi
  out="$(grep -E "^(upgrading|downgrading) '" "$tmp" 2>/dev/null | \
    sed -E "s/^upgrading '//; s/^downgrading '/(downgraded) /; s/' to '/ -> /; s/'$//" || true)"
  rm -f "$tmp"
  printf '%s\n' "$out" > "$sumfile"
  return "$rc"
}

cmd_upgrade() {
  # The full `nix-env -u` scan instantiates the entire package set to compare
  # versions — the same freeze mechanism as a cold search, so it passes the
  # same RAM gate (R11). A targeted `nixpm upgrade <pkg>` stays ungated.
  if [[ $# -eq 0 ]]; then
    _full_eval_gate "the full upgrade scan (nix-env -u compares against the whole package set)" \
        "Upgrade one package at a time — 'nixpm upgrade <name>' skips the scan." \
        || exit 3
  fi

  # `nix-env -u` only compares against the already-fetched channel snapshot;
  # without a refresh first, "upgrade" silently finds nothing to do even when
  # newer versions exist upstream. Refresh first, like `pacman -Syu`.
  _update_index || warn "Continuing with the existing snapshot; run 'nixpm update' when connectivity returns."

  local summary="" piece sumfile
  sumfile="$(mktemp)" || die "Failed to create a temporary file."
  if [[ $# -eq 0 ]]; then
    out "Upgrading all installed packages..."
    _upgrade_run "$sumfile" nix-env -u || { local rc=$?; rm -f "$sumfile"; return "$rc"; }
    summary="$(<"$sumfile")"
  else
    for pkg in "$@"; do
      out "Upgrading ${pkg}..."
      _upgrade_run "$sumfile" nix-env -u "$pkg" || { local rc=$?; rm -f "$sumfile"; return "$rc"; }
      piece="$(<"$sumfile")"
      if [[ -n "$piece" ]]; then
        [[ -n "$summary" ]] && summary+=$'\n'
        summary+="$piece"
      fi
    done
  fi
  rm -f "$sumfile"

  if [[ -n "$summary" ]]; then
    ok "Upgrades applied:"
    printf '%s\n' "$summary" | sort -u | sed 's/^/  /'
  else
    ok "Everything is up to date."
  fi
  _post_install_reload
}

cmd_shell() {
  [[ $# -eq 0 ]] && die "Usage: nixpm shell <pkg> [pkg...]"
  local pkgs=()
  for p in "$@"; do pkgs+=("-p" "$p"); done
  out "Entering Nix shell with: ${C_B}$*${C_RST}"
  nix-shell "${pkgs[@]}"
}

cmd_info() {
  local pkg
  pkg="${1:-}"
  [[ -z "$pkg" ]] && die "Usage: nixpm info <pkg>"
  out "Metadata for ${C_B}${pkg}${C_RST}:"

  local meta="" errfile
  errfile="$(mktemp)" || die "Failed to create a temporary file."

  # Two equivalent ways to reach the metadata, covering both setup styles:
  #   1) flake reference   — flakes-only / flake-registry systems
  #   2) channel import    — traditional channel systems
  # The first one that evaluates wins.
  if ! meta=$(_nix_x eval --json "${NIXPM_NIXPKGS}#${pkg}.meta" 2>"$errfile"); then
    if ! meta=$(_nix_x eval --json --impure \
                   --expr "(import <${NIXPM_NIXPKGS}> {}).${pkg}.meta" 2>>"$errfile"); then
      meta=""
    fi
  fi

  if [[ -n "$meta" ]]; then
    if has_cmd jq; then
      printf '%s\n' "$meta" | jq -r '(
        "Name:        \(.name // .pname // "?")",
        "Description: \(.description // "—")",
        "Homepage:    \(.homepage // "—")",
        "License:     \(.license.spdxId // .license.fullName // .license.shortName // "—")",
        "Shell hook:  \(.hasShellHook // false)",
        "Main program: \(.mainProgram // "—")"
      )' 2>/dev/null || printf '%s\n' "$meta"
    else
      warn "jq not found — showing raw JSON metadata."
      printf '%s\n' "$meta"
    fi
    rm -f "$errfile"
    return 0
  fi

  # Last resort: verify existence without any version-specific flags, so a
  # package is never reported "not found" while it is actually available.
  local avail
  if ! avail=$(nix-env -qaA "${NIXPM_NIXPKGS}.${pkg}" 2>/dev/null) || [[ -z "$avail" ]]; then
    rm -f "$errfile"
    die "Package '${pkg}' not found in '${NIXPM_NIXPKGS}'."
  fi
  warn "Package exists, but its metadata could not be evaluated."
  if [[ -s "$errfile" ]]; then
    head -n 1 "$errfile" | sed 's/^/  /'
  fi
  printf '%s\n' "$avail" | head -5 | sed 's/^/  /'
  rm -f "$errfile"
}

cmd_apps() {
  out "Installed packages with .desktop files:"
  local found=0

  while IFS= read -r line; do
    local pkg outpath rest p pfx dfiles
    pkg=${line%%[$' \t']*}
    # Trim leading whitespace to get the out-path field
    outpath="${line#*[$' \t']}"
    outpath="${outpath#"${outpath%%[![:space:]]*}"}"
    # Multi-output packages print several "attr=/nix/store/..." entries joined
    # by ';' (e.g. geany: 'bin=...;man=...;dev=...') instead of one bare path.
    # Strip the attr= prefixes and check every output — the .desktop files can
    # live in any of them, so collect across all outputs before deciding.
    dfiles=""
    rest="$outpath"
    while :; do
      p="${rest%%;*}"
      pfx="${p#*=}"
      if [[ -n "$pfx" && -d "$pfx/share/applications" ]]; then
        dfiles+="$(find "$pfx/share/applications" -maxdepth 1 -name '*.desktop' -print0 2>/dev/null | \
                   tr '\0' '\n' | head -n 5)"$'\n'
      fi
      [[ "$p" == "$rest" ]] && break   # no ';' left: p was the final segment
      rest="${rest#*;}"
    done
    [[ -n "$dfiles" ]] || continue

    found=$((found + 1))
    printf "%b%s%b\n" "$C_B" "$pkg" "$C_RST"
    while IFS= read -r df; do
      [[ -n "$df" ]] && printf "  %s\n" "$(basename "$df")"
    done <<< "$dfiles"
  done < <(nix-env -q --out-path 2>/dev/null)

  if [[ $found -eq 0 ]]; then
    warn "No installed Nix packages ship .desktop files."
    info "They may still be available as CLI tools."
  fi
}

cmd_restart_menu() {
  if ! _reload_session; then
    die "Could not reload the desktop session."
  fi
}

cmd_version() {
  printf "nixpm %s\n" "$NIXPM_VERSION"
}

# Print a numbered table of one profile's generations (dates + closure sizes).
_print_generations() {
  local base="$1" dir n when size cur
  dir="$(_profile_dir)"
  while IFS=$'\t' read -r n when size; do
    cur=""
    [[ "$(readlink "$dir/$base" 2>/dev/null)" == "$base-$n-link" ]] && cur="  <- current"
    printf '  %-4s %-19s  %12s%s\n' "$n" "$when" "$size" "$cur"
  done < <(_profile_generations "$base")
}

cmd_generations() {
  local dir
  dir="$(_profile_dir)"
  [[ -d "$dir" ]] || die "No Nix profile generations found (nothing installed yet?)."

  out "Channels profile — what each nixpkgs snapshot keeps in the store:"
  printf '  %-4s %-19s  %12s\n' "#" "created" "closure size"
  _print_generations channels

  out "User environment profile generations:"
  printf '  %-4s %-19s  %12s\n' "#" "created" "closure size"
  _print_generations profile

  info "Closure size = everything that generation keeps alive in the store, not just its own files."
  out "Reclaim space: nixpm prune"
  info "Free the disk afterwards with: nix-store --gc"
}

cmd_prune() {
  local remove="" do_gc=false arg dir resp
  for arg in "$@"; do
    case "$arg" in
      --gc) do_gc=true ;;
      *)
        if [[ "$arg" =~ ^[0-9]+$ ]]; then
          remove="$arg"
        else
          die "Usage: nixpm prune [N] [--gc] — remove N past generations (default: ask)"
        fi
        ;;
    esac
  done
  dir="$(_profile_dir)"
  [[ -d "$dir" ]] || die "No Nix profile generations found (nothing installed yet?)."

  # Only user-environment generations are pruned. (The channels profile pins
  # nixpkgs snapshots — smaller, rebuilt on every update; `generations` shows
  # both. Add a --channels mode here if you ever want it.)
  local lines=() total current=0 max=0
  mapfile -t lines < <(_profile_generations profile)
  total=${#lines[@]}
  [[ $total -gt 0 ]] || die "No user-environment generations found."
  if [[ "$(readlink "$dir/profile" 2>/dev/null)" =~ profile-([0-9]+)-link ]]; then
    current="${BASH_REMATCH[1]}"
  fi

  # Interactively choose how many past generations to remove.
  if [[ -z "$remove" ]]; then
    if [[ -t 0 ]]; then
      max=$((total - 1))
      [[ $max -ge 1 ]] || { ok "Only the current generation exists — nothing to prune."; return 0; }
      out "Current generations (user environment):"
      _print_generations profile
      info "Prune keeps the current generation and removes past ones from the Nix store,"
      info "starting with the oldest so recent generations stay rollback-able."
      info "1 = the oldest generation, ${max} = all of them."
      read -rp "How many past generations should I remove (max ${max}, 0 = cancel)? [1] " remove || remove=""
      [[ -z "$remove" ]] && remove=1
    else
      die "Nothing to do: 'prune' needs a count when not interactive. Try: nixpm prune N"
    fi
  fi
  [[ "$remove" =~ ^[0-9]+$ ]] || die "Invalid generation count: '${remove}'"
  (( remove == 0 )) && { ok "Nothing removed."; return 0; }
  max=$((total - 1))
  if (( remove > max )); then
    info "${remove} requested — clamped to ${max} (all past generations)."
    remove="$max"
  fi

  # Walk oldest→newest (lines are ascending), skipping the current generation,
  # deleting up to N — so the most recent past generations stay available for
  # rollback as long as possible.
  local removed_total=0 remaining=$remove i line n when size
  for ((i = 0; i < total; i++)); do
    (( remaining > 0 )) || break
    line="${lines[$i]}"
    IFS=$'\t' read -r n when size <<< "$line"
    [[ "$n" == "$current" ]] && continue
    out "Removed generation $n  ($when)  — was keeping ~${size} alive"
    rm -f "$dir/profile-$n-link"
    removed_total=$((removed_total + 1))
    remaining=$((remaining - 1))
  done

  if (( removed_total == 0 )); then
    ok "Nothing removed."
    return 0
  fi
  ok "Removed ${removed_total} past generation(s) — they are only disconnected; the store paths are still on disk."

  # Reclaim the disk space — with --gc consent already given, otherwise ask.
  local reclaim=false
  if [[ "$do_gc" == true ]]; then
    reclaim=true
  elif [[ -t 0 ]]; then
    info "Run 'nix-store --gc' to delete the disconnected store paths that no remaining"
    info "generation or running process references — this cannot be undone."
    read -rp "Reclaim the disk space with 'nix-store --gc' now? [y/N] " resp || resp=""
    case "$resp" in
      y|Y|yes|Yes|YES) reclaim=true ;;
    esac
  fi

  if [[ "$reclaim" == true ]]; then
    out "Running nix-store --gc..."
    nix-store --gc
    ok "Garbage collection finished."
  else
    info "Reclaim the space any time with: nix-store --gc"
  fi
}

cmd_help() {
  cat <<EOF
${C_B}nixpm${C_RST} — a tiny package-manager wrapper around Nix

${C_B}Usage:${C_RST} nixpm <command> [args...]

${C_B}Commands:${C_RST}
  search  <query>              Search nixpkgs
  install <pkg> [pkg...]       Install package(s)
  remove  <pkg> [pkg...]       Uninstall package(s)
  list                         List installed packages
  list-derivations             List installed packages with store paths
  update                       Update channels / flake inputs (optionally preview upgrades)
  upgrade [pkg...]             Refresh index, then upgrade all (or given) packages
  shell   <pkg> [pkg...]       Enter a nix-shell with package(s)
  info    <pkg>                Show package metadata
  apps                         List installed packages with .desktop files
  generations                  Show profile generations & how much disk each holds
  prune   [N] [--gc]           Remove N past generations, oldest first (keeps the current
                               one; prompts if N omitted); --gc also runs nix-store --gc after
  restart-menu                 Reload the desktop session / app menu
  version, --version, -V       Show version
  help,    --help,    -h       Show this help

  --no-restart                 Skip the desktop menu reload (works before or
                               after the subcommand, e.g. 'nixpm install hello
                               --no-restart')

${C_B}Configuration:${C_RST} ~/.config/nixpm/config (bash-sourced)
  NIXPM_NIXPKGS="nixpkgs"       # Nix attribute path (or channel name)
  NIXPM_RESTART_MENU="auto"     # true | false | auto
  NIXPM_SEARCH_CACHE_DIR=...    # Dir for the local search index (default: ~/.cache/nixpm)
  NIXPM_SEARCH_TTL=86400        # Seconds before an index is rebuilt on search
  NIXPM_SEARCH_WORKERS=4        # Eval workers on cold index build (upstream nix
                                # ignores this; Determinate Nix honours it)
  NIXPM_MIN_INDEX_MEM_MB=6144   # Refuse full-package-set operations below this
                                # much RAM, in MB (0 = disable the guard)

${C_B}Notes:${C_RST}
  * "auto" (default) restarts the session only when a supported DE/WM
    (Omarchy, Hyprland, Sway, KDE Plasma) is detected.
  * On unsupported desktops you may need to log out and back in for
    .desktop files to become visible.
  * The FIRST "search" builds a local index by evaluating all of nixpkgs —
    minutes on a modest machine. After that, searches are instant greps
    until the index goes stale. "nixpm update" refreshes packages but does
    not rebuild the search index.
  * Search queries are literal strings, not regular expressions.
  * On machines with less than ~6GB RAM, the first "search" and a full
    "upgrade" refuse to run (they evaluate the entire package set and can
    freeze small machines). Install or upgrade single packages by name —
    that never evaluates the full set.
  * Exit codes: 0 = success, 1 = failure / no match,
    3 = cannot run (e.g. the low-RAM guard refused a full evaluation).

EOF
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
main() {
  # Parse global flags that appear BEFORE the subcommand.
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)    cmd_help; exit 0 ;;
      -V|--version) cmd_version; exit 0 ;;
      --no-restart) NIXPM_RESTART_MENU="false"; shift ;;
      --) shift; break ;;
      -*) die "Unknown flag: $1" ;;
      *) break ;;
    esac
  done

  [[ $# -eq 0 ]] && { cmd_help; exit 1; }

  local cmd="$1" a
  shift

  # Reject unknown commands before any nix complaint (nicer on a fresh
  # machine: the typo error, not the nix error).
  case "$cmd" in
    search|S|install|i|remove|uninstall|rm|list|ls|Q|list-derivations|ld|\
    update|u|upgrade|U|shell|s|info|I|apps|restart-menu|refresh|\
    generations|gens|prune|version|--version|-V|help|--help|-h) ;;
    *) die "Unknown command: $cmd. Run 'nixpm help' for usage." ;;
  esac

  # Global flags are honoured on EITHER side of the subcommand: strip
  # --no-restart from the remaining argv so it is never mistaken for a
  # package name ('nixpm install hello --no-restart' used to try to install
  # '--no-restart'). Command-specific flags (prune's --gc) stay untouched.
  local args=()
  for a in "$@"; do
    if [[ "$a" == "--no-restart" ]]; then
      NIXPM_RESTART_MENU="false"
    else
      args+=("$a")
    fi
  done

  # Nix preflight: help/version work everywhere, even on a machine that has
  # no nix yet (R1 — this is the stranger's first command). Everything else
  # passes the SAME guard, exactly once, here — never inside a command.
  # Two separate err calls on purpose: the message prints through printf
  # "%s", so a "\n" written inside one string would show literally.
  case "$cmd" in
    help|--help|-h|version|--version|-V) ;;
    *)
      if ! has_cmd nix; then
        err "Nix is not installed or not on PATH."
        err "See https://nixos.org/download/"
        exit 1
      fi
      ;;
  esac

  case "$cmd" in
    search|S)              cmd_search ${args[@]+"${args[@]}"} ;;
    install|i)             cmd_install ${args[@]+"${args[@]}"} ;;
    remove|uninstall|rm)   cmd_remove ${args[@]+"${args[@]}"} ;;
    list|ls|Q)             cmd_list ;;
    list-derivations|ld)   cmd_list_derivations ;;
    update|u)              cmd_update ;;
    upgrade|U)             cmd_upgrade ${args[@]+"${args[@]}"} ;;
    shell|s)               cmd_shell ${args[@]+"${args[@]}"} ;;
    info|I)                cmd_info ${args[@]+"${args[@]}"} ;;
    apps)                  cmd_apps ;;
    restart-menu|refresh)  cmd_restart_menu ;;
    generations|gens)      cmd_generations ;;
    prune)                 cmd_prune ${args[@]+"${args[@]}"} ;;
    version|--version|-V)  cmd_version ;;
    help|--help|-h)        cmd_help ;;
  esac
}

main "$@"
